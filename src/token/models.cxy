module models

import { Time } from "stdlib/time.cxy"

exception NotImplementedError(msg: String) => msg.str()

// TokenResponse holds the OAuth token response from the provider
@json(partial: true)
pub struct TokenResponse {
    @json(name: "access_token")
    accessToken: String = null
    @json(name: "token_type")
    tokenType: String = "Bearer".S
    @json(name: "expires_in")
    expiresIn: i64? = null
    @json(name: "refresh_token")
    refreshToken: String? = null
    scope: String? = null
    @json(ignore: true)
    - _issuedAt: i64 = 0          // Unix timestamp when token was issued

    func `init`() {
        _issuedAt = Time().timestamp()
    }

    // Check if the token is expired
    func isExpired(): bool {
        if !expiresIn {
            return false  // No expiration info, assume valid
        }

        var now = Time().timestamp()
        var expiresAt = _issuedAt + (*expiresIn)
        return now >= expiresAt
    }

    // Get seconds until expiration (negative if expired)
    func expiresInSeconds(): i64? {
        if !expiresIn {
            return null
        }

        var now = Time().timestamp()
        var expiresAt = _issuedAt + (*expiresIn)
        return expiresAt - now
    }

    // Get the Unix timestamp when token expires
    func expiresAt(): i64? {
        if !expiresIn {
            return null
        }
        return _issuedAt + (*expiresIn)
    }
}

// TokenStorage interface for storing tokens
pub class TokenStorage {
    // Save a token with the given key
    virtual func save(key: String, token: TokenResponse): void

    // Load a token by key (returns null if not found)
    virtual func load(key: String): TokenResponse?

    // Delete a token by key
    virtual func remove(key: String): void

    // Clear all tokens
    virtual func clear(): void
}
